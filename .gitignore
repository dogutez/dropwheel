.DS_Store
/.build/
/.swiftpm/
/build/
*.xcodeproj/xcuserdata/
# Release artifacts are uploaded to GitHub Releases, not committed.
/release/*.zip
/release/appcast.xml
# Local settings (feed, public key, signing identity). The public key is not secret,
# but the file may also name a notary profile; keep it per machine.
/release/update.env
# Never commit signing keys.
*.key
