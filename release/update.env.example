# Copy to release/update.env (not committed) to build with updates switched on.
DROPWHEEL_REPO="dogutez/dropwheel"
# From: swift scripts/update-signing.swift generate   (the public half; safe to share)
DROPWHEEL_ED_PUBLIC_KEY=""
# Optional, once you have an Apple Developer account:
# DROPWHEEL_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# DROPWHEEL_NOTARY_PROFILE="dropwheel-notary"   # xcrun notarytool store-credentials dropwheel-notary ...
